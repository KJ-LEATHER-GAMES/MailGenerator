+Private Function TryGetMetadataDateValue( _
+    ByVal rawValue As Variant, _
+    ByRef dateValue As Date _
+) As Boolean
+
+    TryGetMetadataDateValue = False
+
+    If IsError(rawValue) Or _
+       IsNull(rawValue) Or _
+       IsEmpty(rawValue) Then
+        Exit Function
+    End If
+
+    Select Case VarType(rawValue)
+
+        Case vbDate, vbByte, vbInteger, vbLong, _
+             vbSingle, vbDouble, vbCurrency, vbDecimal
+
+            On Error GoTo InvalidDate
+            dateValue = CDate(rawValue)
+            On Error GoTo 0
+
+            TryGetMetadataDateValue = True
+            Exit Function
+
+        Case Else
+            Exit Function
+
+    End Select
+
+InvalidDate:
+    On Error GoTo 0
+    TryGetMetadataDateValue = False

 End Function
